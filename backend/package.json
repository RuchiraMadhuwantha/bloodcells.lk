{
  "name": "blood-donation-system-backend",
  "version": "1.0.0",
  "description": "Backend for the blood donation management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "email:verify": "node scripts/checkEmailConnection.js",
    "db:email:setup": "node scripts/setupEmailDelivery.js",
    "db:request-transfers:setup": "node scripts/setupRequestTransfers.js",
    "db:setup": "node scripts/setupDb.js",
    "db:hospital:complete": "node scripts/setupHospitalCompletion.js",
    "db:collections:setup": "node scripts/setupCollections.js",
    "db:campaign-donations:setup": "node scripts/setupCampaignDonations.js",
    "db:bank-notifications:setup": "node scripts/setupBankNotifications.js",
    "db:campaigns:setup": "node scripts/setupCampaignHospitals.js",
    "db:seed:demo": "node scripts/seedDemo.js",
    "db:seed:hospitals": "node scripts/seedHospitalPortal.js",
    "db:seed:incoming-transfers": "node scripts/seedIncomingTransfers.js",
    "db:seed:expiry": "node scripts/seedBankExpiry.js",
    "test:hospital:completion": "node --test tests/hospitalCompletion.test.js",
    "check:hospital:completion": "node scripts/checkHospitalCompletion.js",
    "test:hospital": "node --test tests/hospitalOperations.test.js",
    "test:transfers": "node --test tests/hospitalTransfers.test.js",
    "db:hospital:check": "node scripts/hospitalMigration.js --check",
    "test:bank": "node --test tests/bankOperations.test.js",
    "db:bank:check": "node scripts/bankMigration.js --check"
  },
  "dependencies": {
    "bcrypt": "6.0.0",
    "cors": "^2.8.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-validator": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.9.0",
    "nodemailer": "10.6.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
